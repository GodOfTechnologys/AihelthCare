# Global
USE_CLOUD=false
ALLOWED_ORIGIN=http://localhost:3000
JWT_SECRET=dev_secret_change_me

# Database
SERVER_DB_PROVIDER=sqlite
# For sqlite, prisma uses file:./dev.db
DATABASE_URL=file:./dev.db

# Cloud Postgres alternative
# DATABASE_URL=postgresql://user:password@host:5432/dbname?schema=public

# OpenAI (optional)
OPENAI_API_KEY=

# Supabase (optional)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# S3-compatible storage (optional)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=globalsmarthub
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Client
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000
