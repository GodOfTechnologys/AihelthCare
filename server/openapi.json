    "/api/auth/login": { "post": { "responses": { "200": { "description": "login" } } } },
    "/api/users": { "get": { "responses": { "200": { "description": "list users" } } } },
    "/api/messages": { "get": { "responses": { "200": { "description": "list messages" } } }, "post": { "responses": { "200": { "description": "create message" } } } },
